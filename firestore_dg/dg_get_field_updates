function skill_rating(endpoint) {

  console.log('fetching endpoint: '+endpoint)

  const std_dataset = [];
  
  try {
    const response = UrlFetchApp.fetch(endpoint, { muteHttpExceptions: true });
    
    if (response.getResponseCode() !== 200) {
      console.warn(`Fetch skipped: Status ${response.getResponseCode()}`);
      return; 
    }

    const data = JSON.parse(response.getContentText());
    const dataset = data?.players; // Use optional chaining

    if (!dataset || !Array.isArray(dataset)) {
      console.warn("No player data found in the response.");
      return;
    }

    dataset.forEach((item) => {
      std_dataset.push({
        dg_id: item?.dg_id ?? '',
        skrt_driving_acc: item?.driving_acc ?? '',
        skrt_driving_dist: item?.driving_dist ?? '',
        skrt_sg_app: item?.sg_app ?? '',
        skrt_sg_arg: item?.sg_arg ?? '',
        skrt_sg_ott: item?.sg_ott ?? '',
        skrt_sg_putt: item?.sg_putt ?? '',
        skrt_sg_total: item?.sg_total ?? '',
      });
    });

  if (std_dataset && Array.isArray(std_dataset) && std_dataset.length > 0) {
    return std_dataset
  } else {
    console.warn("No data found in the API response.");
  }

  } catch (e) {
    console.error(`Failed to fetch DataGolf rankings: ${e.message}`);
  }
}

