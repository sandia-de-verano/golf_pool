/**
 * High-Performance Firestore REST API Client with Field Masking
 */

/**
 * Standard document PATCH write using explicit field paths mask.
 * 
 * @param {string} collection 
 * @param {string} documentId 
 * @param {Object} fields - Structured REST payload fields
 */
function writeFirestoreDocument(collection, documentId, fields) {
  const projectId = getScriptProperty('GCP_PROJECT_ID');
  const firestoreToken = ScriptApp.getOAuthToken();
  const baseUrl = `https://firestore.googleapis.com/v1/projects/${projectId}/databases/(default)/documents/${collection}/${documentId}`;

  const fieldMasks = Object.keys(fields)
    .map(key => `updateMask.fieldPaths=${key}`)
    .join('&');

  const options = {
    method: 'patch',
    contentType: 'application/json',
    headers: { Authorization: `Bearer ${firestoreToken}` },
    payload: JSON.stringify({ fields: fields }),
    muteHttpExceptions: true
  };

  const response = UrlFetchApp.fetch(`${baseUrl}?${fieldMasks}`, options);
  if (response.getResponseCode() !== 200) {
    throw new Error(`Firestore Write Failed [${collection}/${documentId}]: ${response.getContentText()}`);
  }
}

/**
 * Executes targeted map updates (`pre_data`, `live`, or `official`) without rewriting sibling maps.
 * 
 * @param {string} collection 
 * @param {string} documentId 
 * @param {string} mapKey - Target map path ('pre_data', 'live', or 'official')
 * @param {Object} mapTypedFields - Serialized map fields
 * @param {Object} rootFields - Supplementary top-level metadata fields
 */
function patchFirestoreMapPath(collection, documentId, mapKey, mapTypedFields, rootFields) {
  const projectId = getScriptProperty('GCP_PROJECT_ID');
  const firestoreToken = ScriptApp.getOAuthToken();
  const baseUrl = `https://firestore.googleapis.com/v1/projects/${projectId}/databases/(default)/documents/${collection}/${documentId}`;

  const maskPaths = [`updateMask.fieldPaths=${mapKey}`];
  
  const payloadFields = {
    [mapKey]: {
      mapValue: {
        fields: mapTypedFields
      }
    }
  };

  if (rootFields) {
    Object.keys(rootFields).forEach((rk) => {
      maskPaths.push(`updateMask.fieldPaths=${rk}`);
      payloadFields[rk] = rootFields[rk];
    });
  }

  const url = `${baseUrl}?${maskPaths.join('&')}`;

  const options = {
    method: 'patch',
    contentType: 'application/json',
    headers: { Authorization: `Bearer ${firestoreToken}` },
    payload: JSON.stringify({ fields: payloadFields }),
    muteHttpExceptions: true
  };

  const response = UrlFetchApp.fetch(url, options);
  if (response.getResponseCode() !== 200) {
    throw new Error(`Firestore Targeted Patch Failed [${collection}/${documentId}]: ${response.getContentText()}`);
  }
}

/**
 * System Failure Logging Engine
 */
function handlePipelineError(context, error) {
  const errorTimestamp = new Date().toISOString();
  Logger.log(`[ERROR] [${context}] ${error.toString()}`);

  try {
    const errorFields = {
      context: Serializer.str(context),
      error_message: Serializer.str(error.toString()),
      stack_trace: Serializer.str(error.stack || 'N/A'),
      timestamp_utc: Serializer.str(errorTimestamp),
      schema_version: Serializer.int(CONFIG.SCHEMA_VERSION)
    };

    writeFirestoreDocument('trigger_errors', `err_${Date.now()}`, errorFields);

    const adminEmail = PropertiesService.getScriptProperties().getProperty('ADMIN_EMAIL');
    if (adminEmail) {
      MailApp.sendEmail({
        to: adminEmail,
        subject: `[CRITICAL PIPELINE FAILURE] ${context}`,
        body: `Error in ${context} at ${errorTimestamp} UTC:\n\n${error.toString()}\n\nStack:\n${error.stack}`
      });
    }
  } catch (secondaryErr) {
    Logger.log(`[CRITICAL] Secondary Error Handler Failed: ${secondaryErr.toString()}`);
  }
}
