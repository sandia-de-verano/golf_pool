// get_past_event_earnings

function get_past_event_earnings() {

  const current_tournament = readSheetData(CURRENT_TOURNAMENT);
    const event_id = current_tournament[0].event_id;
    const event_name = current_tournament[0].event_name;

  let pool_tour = readSheetData(SHT_ESPN_HIST_EVT);

  const url_constants = pool_tour
    .filter(item => String(item.event_id) === String(event_id) &&  String(item.event_name) === String(event_name));

  console.log('number of events: '+url_constants.length)

  const url_event = url_constants.map(function(obj) {
        return [
      obj.url_event || `http://sports.core.api.espn.com/v2/sports/golf/leagues/pga/events/${obj.event_id_espn}?lang=en&region=us` || '',
      obj.year 
    ];
  });

 var dataset = [];
 var headers = ['year','n_comp','order','earnings']
    
  for (var i = 0; i < url_event.length; i++) {
    // Wrap the INSIDE of the loop in try-catch
    try {
      var year = url_event[i][1];
      const response = UrlFetchApp.fetch(url_event[i][0], {muteHttpExceptions: true});
      
      if (response.getResponseCode() !== 200) {
        // This will now jump to the catch below, then continue to the next 'i'
        console.warn(`Skipping: HTTP Error ${response.getResponseCode()} for ${url_event[i][0]}`);
        continue; 
      }

      var data = JSON.parse(response.getContentText());
      
      // Safety check: ensure the ESPN path exists before accessing length
      if (!data.competitions || !data.competitions[0]) continue;
      
      var competitors = data.competitions[0].competitors;
      var n_comp = competitors.length;

      for (var j = 0; j < competitors.length; j++) {
        var player = competitors[j];
        var order = player.order || '';
        var earnings = player.earnings || 0;

        dataset.push([
          year,
          n_comp,
          order,
          earnings
        ]);
      }

    } catch (e) {
      // This catches JSON parsing errors or other unexpected issues
      console.error(`Error processing index ${i} (${url_event[i][0]}): ${e.message}`);
    }
  }

  
  var dataset_filtered = dataset.filter(item => {
    value = item[3]
    return value !== "" && value !== 0;
  });

  console.log('number of rows: '+dataset_filtered.length)

  if (dataset_filtered.length === 0) {
    console.log('No earnings reported')
  }

  SHT_PRIOR_EVT_MONEY.clearContents()
  setValues(dataset_filtered,SHT_PRIOR_EVT_MONEY,headers)
}

function fetch_url(endpoint) {
  // --- 1. Fetch Data ---
  let data;
  try {
    const response = UrlFetchApp.fetch(endpoint, { muteHttpExceptions: true });
    if (response.getResponseCode() !== 200) {
      throw new Error(`HTTP Error ${response.getResponseCode()}`);
    }
    data = JSON.parse(response.getContentText());
  } catch (e) {
    console.log(`Failed to fetch DataGolf field updates: ${e.message}`);
    return;
  }
  return data
}

