function get_pre_tour_data() {
  let std_dataset
  
  const approach_skill = dg_get_prd_approach_skill()
  const player_decomp = dg_get_prd_player_decomp()
  const player_skill_rating = dg_get_prd_skill_rating()
  const pre_tour = dg_get_prd_pre_tour()

  let stats_dataset =  merge_data(player_skill_rating,approach_skill,'dg_id')

  std_dataset = merge_data(player_decomp,pre_tour,'dg_id')
  std_dataset = merge_data(std_dataset,stats_dataset,'dg_id')

  std_dataset.sort((a, b) => a.total - b.total);

  if (std_dataset.length > 0) {
    SHT_PRE_TOUR.clearContents(); 
    setValues_keys(std_dataset, SHT_PRE_TOUR);
    console.log(`Successfully updated pre tour data with ${std_dataset.length} events.`);
  }

  if (stats_dataset.length > 0) {
    SHT_PLAYER_STATS.clearContents(); 
    setValues_keys(stats_dataset, SHT_PLAYER_STATS);
    console.log(`Successfully updated player stats with ${stats_dataset.length} events.`);
  }

  get_past_event_earnings()

}

