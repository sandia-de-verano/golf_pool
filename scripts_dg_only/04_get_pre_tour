// dg_get_prd_approach_skill

function dg_get_prd_approach_skill() {
  const endpoint = `${SOURCEURL}${ENDPT_PRD_APPROACH_SKILL}?${FILEFORMAT}${API_DG}`;

  console.log("Fetching Approach Skill from:", endpoint);

  let std_dataset = [];

  // --- 1. Fetch Data ---
  let data;
  try {
    const response = UrlFetchApp.fetch(endpoint, { muteHttpExceptions: true });
    
    // Explicitly check response code
    if (response.getResponseCode() !== 200) {
      console.warn(`Fetch skipped: Server returned status ${response.getResponseCode()}`);
      return; // Exit gracefully
    }
    
    data = JSON.parse(response.getContentText());

  } catch (e) {
    console.error(`Network or Parsing Error: ${e.message}`);
    return;
  }

  // --- 2. Process Data ---
  const dataset = data?.data;

  dataset.forEach((item) => {
      std_dataset.push({
      "dg_id": item?.dg_id ?? '', 
      ...item

      });
    });


  if (std_dataset && Array.isArray(std_dataset) && std_dataset.length > 0) {
    return std_dataset
  } else {
    console.warn("No data found in the API response.");
  }
}

