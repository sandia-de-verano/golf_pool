function create_updated_selections() {
	const user_selection_data = readSheetData(SHT_USER_SELECTION)
  const std_dataset = [];

  user_selection_data.forEach((row) => {
    let s1_sub = "No", s2_sub = "No", s3_sub = "No", liv_sub = "No";
    let a1s_sub = "", a2s_sub = "";

    // --- INITIALIZE CURRENT STATE ---
    // Start with the original data for this row
    let lineup = {
      s1: { id: cleanValue(row.s1)},
      s2: { id: cleanValue(row.s2)},
      s3: { id: cleanValue(row.s3)},
      liv: { id: cleanValue(row.liv)},
      a1: { id: cleanValue(row.a1)},
      a2: { id: cleanValue(row.a2)},
      aliv: { id: cleanValue(row.altLiv)}
    };

    // --- DEFINE THE SWAP FUNCTION ---
    const executeTrueSwap = (updatedKey, starterKey, slotLabel) => {
      const updatedValClean = cleanValue(row[updatedKey]);
      const currentStarterClean = lineup[starterKey].id;

      if (updatedValClean && updatedValClean !== currentStarterClean) {
        
        let altSlotMatch = null;
        if (lineup.a1.id === updatedValClean) altSlotMatch = 'a1';
        else if (lineup.a2.id === updatedValClean) altSlotMatch = 'a2';
        else if (lineup.aliv.id === updatedValClean) altSlotMatch = 'aliv';

        if (altSlotMatch) {
          // Perform the Swap
          let tempStarter = { ...lineup[starterKey] };
          lineup[starterKey] = { ...lineup[altSlotMatch] }; // Alt moves to Starter
          lineup[altSlotMatch] = tempStarter;              // Starter moves to Alt

          // Update UI/Metadata Flags
          if (starterKey === 's1') s1_sub = "Yes";
          if (starterKey === 's2') s2_sub = "Yes";
          if (starterKey === 's3') s3_sub = "Yes";
          if (starterKey === 'liv') liv_sub = "Yes";
          if (altSlotMatch === 'a1') a1s_sub = slotLabel;
          if (altSlotMatch === 'a2') a2s_sub = slotLabel;
        }
      }
    };

    executeTrueSwap('updated_s1', 's1', 'S1');
    executeTrueSwap('updated_s2', 's2', 'S2');
    executeTrueSwap('updated_s3', 's3', 'S3');
    executeTrueSwap('updated_liv', 'liv', 'LIV');

    std_dataset.push({
      key: row.key, 
      year: row.year,
      event_id: row.event_id,
      event_name: row.event_name, 
      user_name: row.user_name, 
      user_email: row.user_email, 
      S1_SUB: s1_sub, 
      S2_SUB: s2_sub, 
      S3_SUB: s3_sub, 
      LIV_SUB: liv_sub, 
      A1_S_SWAP: a1s_sub, 
      A2_S_SWAP: a2s_sub, 
      dg_id_s1: lineup.s1.id ?? '',	
      dg_id_s2: lineup.s2.id ?? '',	
      dg_id_s3: lineup.s3.id ?? '',
      dg_id_liv: lineup.liv.id ?? '',
      dg_id_a1: lineup.a1.id ?? '',	
      dg_id_a2: lineup.a2.id ?? '',	
      dg_id_liv_a: lineup.aliv.id ?? '',
    })
  });


  // 3. Write Data
  if (std_dataset.length > 0) {
    SHT_UPDATE_USER_SELECTIONS.clearContents();
    setValues_keys(std_dataset,SHT_UPDATE_USER_SELECTIONS)
    //const range = SHT_UPDATE_USER_SELECTIONS.getRange(1, 1, finalOutputArray.length, finalOutputArray[0].length);
    //range.setValues(finalOutputArray);
  }
}

