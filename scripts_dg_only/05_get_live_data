function processData(rawData) {
  const userMap = [];
  const EARNINGS_TYPES = ['s1', 's2', 's3', 'liv'];

  rawData.forEach(row => {
    const key = row.key;
    if (!userMap[key]) {
      userMap[key] = {
        key: row.key,
        user_name: row.user_name,
        event_name: row.event_name,
        totalEarnings: 0,
        earn_flag: row.earn_flag,
        break_s1: '',
        break_s2: '',
        break_s3: '',
        break_liv: '',
        break_a1: '',
        break_a2: '',
        break_liv_a: '',
        data: {}
      };
    }

    if (EARNINGS_TYPES.includes(row.type)) {
      userMap[key].totalEarnings += parseFloat(row.earnings || 0);
    }

    userMap[key].data[row.type] = {
      id: String(row.dg_id),
      sub: row.sub,
      pos: row.position,
      name: row.player_name_clean,
      thru: row.thru,
      score: row.score || 0,
      earn: row.earnings,
      rank_score_thru: row.rank_score_thru
    };
  });

  return Object.values(userMap);
}
