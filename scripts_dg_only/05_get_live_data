function calculateGolfWinnings(players, prizeMap, tournamentStarted) {
  
  // 1. Identify "Active" real players (those with scores, not WD/CUT)
  const activeRealPlayers = players.filter(p => 
    p.player_name !== "DATA GOLF CUT" && 
    p.player_name !== "PREDICTED CUT" && 
    p.current_position !== "WD" && 
    p.current_position !== "CUT" &&
    p.current_position !== "DQ"
  );

  // 2. Assign Effective Ranks
  players.forEach(player => {
    const isCutLine = (player.player_name === "DATA GOLF CUT" || player.player_name === "PREDICTED CUT");
    
    if (isCutLine) {
      // Logic: Rank = (Count of real players with a better score) + 1
      // We use a small decimal (+ 0.5) so they sort AFTER players tied at the same score
      const betterPlayers = activeRealPlayers.filter(p => (p.total || 0) < (player.total || 0)).length;
      player.effective_rank = betterPlayers + 1.5; 
      
    } else {
      // Standard logic for real players
      const rawRank = parseInt((player.current_position || '').toString().replace(/[^0-9]/g, ""));
      const uncut_status = player.current_position;

      if (uncut_status === "CUT" || uncut_status === "WD" || uncut_status === "DQ") {
        player.effective_rank = 500;
      } else if (isNaN(rawRank)) {
        // If pre-tour, use the adjusted rank mapping
        player.effective_rank = tournamentStarted ? 500 : 999; // Fallback
      } else {
        player.effective_rank = rawRank;
      }
    }
  });

  // 3. Count occurrences for TIE LOGIC (EXCLUDING CUT LINES)
  // We do not want the ghost rows to increment the "Tie Count" for real players
  const positionCounts = players.reduce((acc, player) => {
    const isCutLine = (player.player_name === "DATA GOLF CUT" || player.player_name === "PREDICTED CUT");
    const intRank = Math.floor(player.effective_rank);
    
    if (player.effective_rank && !isCutLine && player.effective_rank < 500) {
      acc[intRank] = (acc[intRank] || 0) + 1;
    }
    return acc;
  }, {});

  // 4. Distribute Winnings
  players.forEach((player) => {
    const isCutLine = (player.player_name === "DATA GOLF CUT" || player.player_name === "PREDICTED CUT");
    
    // Cut lines and WD players get $0
    if (isCutLine || !player.effective_rank || player.effective_rank >= 500) {
      player.projected_earnings = 0;
      player.earnings = 0;
      return;
    }

    const startRank = Math.floor(player.effective_rank);
    const count = positionCounts[startRank];

    if (count > 1) {
      // TIE LOGIC
      let totalTiePool = 0;
      for (let i = 0; i < count; i++) {
        totalTiePool += (prizeMap[startRank + i] || 0);
      }
      player.projected_earnings = totalTiePool / count;
    } else {
      // SOLO LOGIC
      player.projected_earnings = prizeMap[startRank] || 0;
    }
  });

  return players;
}

function safelyParseDate(dateVal) {
  if (!dateVal || dateVal === "" || dateVal === "0") return null; 
  const d = new Date(dateVal);
  return isNaN(d.getTime()) ? null : d;
}

