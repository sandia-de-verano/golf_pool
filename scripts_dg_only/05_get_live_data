function flattenData_v2(data) {
  data.sort((a, b) => b.totalEarnings - a.totalEarnings);

  // Assign Ranks
  data.forEach((user, i) => {
    if (i > 0 && user.totalEarnings === data[i - 1].totalEarnings) {
      user.rank = data[i - 1].rank;
    } else {
      user.rank = i + 1;
    }
  });

 const finalData = [];

  data.forEach(user => {

    const row = [
      user.key, 
      user.event_name, 
      user.rank, 
      user.user_name, 
      user.totalEarnings,
      user.earn_flag,
      user.header_s1,
      user.header_s2,
      user.header_s3,
      user.header_liv,
      user.header_a1,
      user.header_a2,
      user.header_liv_a,
    ];

  // selections    
    const select_details = user.data; 
    const types = ['s1', 's2', 's3', 'liv', 'a1', 'a2', 'liv_a'];
    // data for selections  
    
    types.forEach(type => {
      const typeData = select_details[type] ||{};
      row.push(
        typeData.id || '',
        typeData.sub || '',
        typeData.pos || '',
        typeData.name || '',
        typeData.thru || '',
        typeData.score || 0,
        typeData.earn || 0,
        typeData.rank_score_thru
      );
    })

  finalData.push(row)
  });

  return finalData
}

// _____________________________________________

function cleanValue(value) {
  if (!value || typeof value !== 'string') return value;
  
  // This regex looks for digits followed by a hyphen and space at the start
  // or simply splits by the first hyphen if found.
  if (value.includes(' - ')) {
    return value.split(' - ').slice(1).join(' - ').trim();
  }
  return value.trim();
}

function sumField(array, field) {

  if (!Array.isArray(array)) {
    throw new Error("First argument must be an array");
  }

  return array.reduce((total, obj) => {
    // Ensure the field exists and is a number
    const value = Number(obj[field]);
    return total + (isNaN(value) ? 0 : value);
  }, 0);

}

