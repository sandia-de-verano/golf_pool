function email_pool_open() {
  const current_event = readSheetData(CURRENT_TOURNAMENT);

// --- Validation ---
  if (!current_event) return;
  if (!current_event[0].isPoolEvent) {console.log('Not Pool Event'); return};

    const today = new Date();
    today.setHours(0, 0, 0, 0);

    const lookup = new Date(current_event[0].pool_opens);
    lookup.setHours(0, 0, 0, 0);

  const isToday = today.getTime() === lookup.getTime();

  if (!isToday) {
    console.log("The deadline is not today. Skipping.");
    return; // Exit early if not today
  }
  console.log("The deadline is today! Sending emails...");

// --- get data ---

  const replyTo = "";
  const curr_event_name = current_event[0].event_name;
  const due = current_event[0].picks_due;
  const users = readSheetData(SHT_USERS)
    if (!users || users.length === 0) return;
    const columnHeaders = Object.keys(users[0]);
    const dateKey = 'pool_open_date_sent'; // <--- Ensure this matches your Sheet Header exactly
    const dateColIndex = columnHeaders.indexOf(dateKey) + 1;
      if (dateColIndex === 0) {
        console.log(`Warning: Column "${dateKey}" not found in SHT_USERS. Dates will not be recorded.`);
      }

  const subject = `⛳ Make Selections: ${curr_event_name} - Pool Open`;

  users.forEach((row, index) => {
    let tz = row.tz;
    let due_date = formatDateTimeSafe_emails(due,tz);
    let email = row.user_email.toString().toLowerCase().trim();
    let is_active = row.is_active;
    const date_sent = row.pool_open_date_sent
    const alreadySentToday = date_sent && new Date(date_sent).toDateString() === new Date().toDateString(); 

    if (email && is_active && !alreadySentToday) {

      const htmlBody = `
        <p>Hello, amazing humans!</p> 
        <p>It's your friendly digital caddie, Hogan G. Wooodland! I'm here with a tee-rific reminder! 🏌️‍♂️</p>
        <p>Selections for ⛳ ${curr_event_name} are OPEN!</p>
        <p>Make your selections here: <a href=${APP_LINK}>Fairway Pool</a></p>
        <p>🌟 Deadline for selections is <b>${due_date}</b> 🌟</p>
        <br>
        <p>Sincerely,</p>
        <p><b>Team Fairway Pool</b><br>
        <font face="arial, sans-serif" size="2">General ne'er do wells, Attempted cat herders, and Agents of Chaos</font></p>
      `;
    
    console.log(htmlBody)

     MailApp.sendEmail({
        to: email,
        subject: subject,
        htmlBody: htmlBody,
        replyTo: replyTo,
        name: 'Hogan Woodland, Digital Caddie',
      });
        
        if (dateColIndex > 0) {
          SHT_USERS.getRange(index + 2, dateColIndex).setValue(new Date());
        }
        console.log("Email sent to: " + email);

      } else {
        //console.log("No reminder needed for: " + email);
      }
    });

}

