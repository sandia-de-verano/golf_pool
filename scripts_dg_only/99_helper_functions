function flattenObject(obj, parentKey = '', separator = '_') {
  const flattened = {};

  for (const key in obj) {
    if (!obj.hasOwnProperty(key)) continue;

    const value = obj[key];
    // Create the new key name: parentKey + separator + key
    const newKey = parentKey ? `${parentKey}${separator}${key}` : key;

    // Check if the value is an object (but not null or an Array)
    if (typeof value === 'object' && value !== null && !Array.isArray(value)) {
      // Recursively flatten nested objects
      Object.assign(flattened, flattenObject(value, newKey, separator));
    } else if (Array.isArray(value)) {
      // Handle arrays: flatten each element and prepend the new key
      value.forEach((element, index) => {
        const arrayKey = `${newKey}${separator}${index}`;
        if (typeof element === 'object' && element !== null) {
          Object.assign(flattened, flattenObject(element, arrayKey, separator));
        } else {
          flattened[arrayKey] = element;
        }
      });
    } else {
      flattened[newKey] = value;
    }
  }
  return flattened;
}

