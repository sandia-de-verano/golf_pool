function getTournamentEmoji(event_name) {
  const tournamentName = event_name.toLowerCase();
  
  if (tournamentName.includes("masters")) return "🌺";
  if (tournamentName.includes("phoenix")) return "🌵";
  if (tournamentName.includes("players")) return "🏝️";
  if (tournamentName.includes("u.s. open")) return "🗽";
  if (tournamentName.includes("the open")) return "🏺";
  if (tournamentName.includes("st. jude")) return "🎸🎗️";
  if (tournamentName.includes("pga championship")) return "🛡️";
  
  return "⛳"; // Default golf flag
}

