function setValues_keys(dataset, targetSheet) {
try {
  if (!dataset || dataset.length === 0) {
    console.log('JSON array is empty.');
    return;
  }

  const target_row = targetSheet.getLastRow() + 1;
  const s_num_col = targetSheet.getLastColumn();

  const flattenedData = dataset.map(item => flattenObject(item));

  let headers = new Set();
  flattenedData.forEach(item => {
    Object.keys(item).forEach(key => headers.add(key));
  });
  
  headers = Array.from(headers);

  // 3. Convert the flattened objects into a 2D array for setValues()
  const rows = flattenedData.map(item => {
    return headers.map(header => (item.hasOwnProperty(header) ? item[header] : ''));
  });

  // Add the headers as the first row
  if (target_row === 1 || target_row === null  || target_row === undefined){
    rows.unshift(headers);
  } 

  // 4. Batch Write to the Sheet
  const numRows = rows.length;
  const numCols = headers.length;

  if (s_num_col != numCols && s_num_col > 0) {
    console.log('Number of colums in sheet does not match the number of columns in the data. Please check.')
    return
  }
  
  // Clear existing content and set new data efficiently
  const targetRange = targetSheet.getRange(target_row, 1, numRows, numCols);
  targetRange.setValues(rows);

  console.log(`Successfully wrote ${numRows} rows and ${numCols} columns to the sheet.`);
} catch (e) {
  console.log(`[ERROR] setValues_keys: ${e.message} at line ${e.lineNumber}`);
}

}

