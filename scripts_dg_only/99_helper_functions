function dedup(array, key) {
  const cleanMap = new Map();
  array.forEach(item => {
    const id = String(item?.[key] || "");
    if (id) cleanMap.set(id, item); // Last one seen wins
  });
  return Array.from(cleanMap.values());
}

// ------------------------------------------------------------------------------

function dedup_all_fields(dataset) {
  if (!Array.isArray(dataset)) return [];

  const uniqueMap = new Map();

  dataset.forEach(item => {
    // 1. Stringify the object to create a unique fingerprint
    // Note: We sort the keys first to ensure {a:1, b:2} matches {b:2, a:1}
    const fingerprint = JSON.stringify(item, Object.keys(item).sort());

    // 2. Map only keeps the last version of this specific fingerprint
    uniqueMap.set(fingerprint, item);
  });

  // 3. Convert back to an array of objects
  return Array.from(uniqueMap.values());
}

