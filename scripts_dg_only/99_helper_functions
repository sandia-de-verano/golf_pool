function merge_full_outer(primary, secondary, joinKey) {
  const secondaryMap = new Map();
  const usedSecondaryIds = new Set();

  // 1. Index the secondary array for fast lookup
  secondary.forEach(obj => {
    const id = String(obj?.[joinKey] || "");
    if (id) secondaryMap.set(id, obj);
  });

  // 2. Process Primary: Merge matches and keep non-matches
  const mergedPrimary = primary.map(baseObj => {
    const id = String(baseObj?.[joinKey] || "");
    const match = secondaryMap.get(id);

    if (match) {
      usedSecondaryIds.add(id); // Mark as "kept"
      return { ...baseObj, ...match }; // Merge
    }
    return baseObj; // Keep primary row as is
  });

  // 3. Collect "Right-Side Only" (rows in secondary but not primary)
  const secondaryOnly = secondary.filter(obj => {
    const id = String(obj?.[joinKey] || "");
    return !usedSecondaryIds.has(id);
  });

  // 4. Combine both results into one final array
  return [...mergedPrimary, ...secondaryOnly];
}

