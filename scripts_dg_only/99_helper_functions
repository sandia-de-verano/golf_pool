function formatDateSafe(date) {
  if (!date || isNaN(new Date(date).getTime())) return null;
  const d = new Date(date);
  // Returns "2026-03-26"
  return d.toISOString().split('T')[0];
}

function formatDateTimeSafe_adjusted(date) {
  if (!date || isNaN(new Date(date).getTime())) return null;
  const d = new Date(date);
  const timezone = "GMT-0"
  
  // Adjust the "GMT-6" to match your specific timezone if needed
  // "yyyy-MM-dd HH:mm:ss" results in 2026-03-26 14:30:00
  return Utilities.formatDate(d, timezone, "yyyy-MM-dd HH:mm:ss");
}

function formatDateTimeSafe(date) {
  if (!date || isNaN(new Date(date).getTime())) return null;
  
  const d = new Date(date);
  const timeZone = Session.getScriptTimeZone();
  const format = "yyyy-MM-dd HH:mm:ss";
  
  // Utilities.formatDate is the "Gold Standard" for Google Apps Script 
  // because it prevents the automatic UTC shift.
  return Utilities.formatDate(d, timeZone, format);
}

function formatDateTimeSafe_emails(date,tz) {
