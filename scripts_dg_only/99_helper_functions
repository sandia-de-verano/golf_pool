function convertUTCtoET(dateString) {

  // 1. Create a Date object from the UTC string.
  // The Date object internally stores the exact moment in time.
  var utcDate = new Date(dateString);

  // 2. Specify the target timezone and desired format.
  var targetTimezone = "America/New_York";
  // The format below includes the date, time (HH:mm:ss), and the timezone abbreviation (z).
  var format = "yyyy-MM-dd HH:mm:ss"; 

  // 3. Use Utilities.formatDate() to perform the conversion.
  var easternTimeString = Utilities.formatDate(
    utcDate,
    targetTimezone,
    format
  );
  
  return easternTimeString;
}

