function transformPlayerString(input) {
  // Regex Breakdown:
  // ^([^,]+)    -> Capture everything from start until the comma (Last Name)
  // ,\s* -> Match the comma and any following spaces
  // ([^(]+)     -> Capture everything until the opening parenthesis (First Name)
  // \s*\(       -> Match spaces and the opening parenthesis
  // (\d+)       -> Capture only the digits inside (The ID)
  // \)$         -> Match the closing parenthesis at the end

  if (!input || typeof input !== 'string') return null;
  
  const cleanInput = input.trim();

  // 1. SKIP "TBD" (Case-insensitive check)
  if (cleanInput.toUpperCase() === "TBD" || cleanInput === "" ) {
    return null
  }

  // 2. REGEX for "Last, First (ID)"
  const regex = /^([^,]+),\s*([^(]+)\s*\((\d+)\)$/;
  const match = cleanInput.match(regex);

  if (match) {
    return {
      dg_id: match[3],
      player_name: `${match[2].trim()} ${match[1].trim()}`
    };
  }

  return null
}

