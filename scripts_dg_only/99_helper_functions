function get_adjusted_rank(p) {
  if (!p) return {};

  let owgr_rank = Number(p.owgr_rank) || 501;
  let dg_rank = Number(p.dg_rank) || 501;

  // Use 'let' here because these values will be changed by the IF statement
  let adjusted_rank;
  let adjusted_rank_display;
  let rank_label;

  if (dg_rank < owgr_rank) {
    adjusted_rank = dg_rank;
    adjusted_rank_display = dg_rank + " (" + owgr_rank + ")";
    rank_label = 'adj';
  } else {
    adjusted_rank = owgr_rank;
    adjusted_rank_display = owgr_rank + " (" + dg_rank + ")";
    rank_label = 'owgr';
  }

  return {
    ...p,
    owgr_rank: owgr_rank,
    dg_rank: dg_rank,
    adjusted_rank: adjusted_rank,
    adjusted_rank_display: adjusted_rank_display,
    rank_label: rank_label,
  };
}

function get_adjusted_rank_datagolf(p) {
  if (!p) return {};

  let owgr_rank = Number(p.owgr_rank) || 501;
  let dg_rank = Number(p.datagolf_rank) || 501;

