function merge_courses_protected(primary, secondary, joinKey) {
  const secondaryMap = new Map();
  const usedSecondaryIds = new Set();

  secondary.forEach(obj => {
    const id = String(obj?.[joinKey] || "").trim();
    if (id) secondaryMap.set(id, obj);
  });

  const merged = primary.map(baseObj => {
    const id = String(baseObj?.[joinKey] || "").trim();
    const updateData = secondaryMap.get(id);

    if (updateData) {
      usedSecondaryIds.add(id);
      
      // LOGIC: If baseObj has a course_code and updateData doesn't, 
      // we make sure the code from baseObj stays.
      return {
        ...baseObj, 
        ...updateData,
        course_code: (baseObj.course_code && !updateData.course_code) 
                      ? baseObj.course_code 
                      : (updateData.course_code || baseObj.course_code)
      };
    }
    return baseObj;
  });

  const secondaryOnly = secondary.filter(obj => !usedSecondaryIds.has(String(obj?.[joinKey] || "").trim()));
  return [...merged, ...secondaryOnly];
}



